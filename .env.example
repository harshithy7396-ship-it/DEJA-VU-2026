# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================================
# Admin Security Configuration
# ===================================================================
# Password for Déjà vu Event Administrator
ADMIN_PASSWORD="harshith2005"

# ===================================================================
# Judge0 CE Execution Backend Configuration
# ===================================================================
# JUDGE0_API_URL: Required URL of the sandboxed Judge0 CE instance.
# Default for self-hosted instances: http://localhost:2358
# For remote or hosted instances: https://judge0-ce.p.rapidapi.com or http://<ip>:2358
JUDGE0_API_URL="http://localhost:2358"

# JUDGE0_API_KEY: Optional RapidAPI key if using RapidAPI-hosted Judge0 CE
JUDGE0_API_KEY=""

# JUDGE0_API_HOST: Optional RapidAPI host header (e.g. judge0-ce.p.rapidapi.com)
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# JUDGE0_AUTH_TOKEN: Optional secret authentication token if your self-hosted Judge0 requires X-Auth-Token
JUDGE0_AUTH_TOKEN=""
